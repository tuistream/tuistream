APP_NAME=TuiStream
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tuistream.local

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuistream
DB_USERNAME=tuistream
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=tuistream
REVERB_APP_KEY=tuistream-reverb-key
REVERB_APP_SECRET=tuistream-reverb-secret
REVERB_HOST=tuistream.local
REVERB_PORT=6001
REVERB_SCHEME=https

ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_SSL_PORT=8001
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
ICECAST_RELAY_PASSWORD=

RTMP_HOST=127.0.0.1
RTMP_PORT=1935
HLS_PORT=8080
DASH_PORT=8081

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

HORIZON_DOMAIN=tuistream.local
HORIZON_PATH=horizon
